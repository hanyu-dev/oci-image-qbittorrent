# === source code: qbittorrent/qBittorrent ===

ARG IMAGE_QBITTORRENT_VERSION
ARG IMAGE_QBITTORRENT_COMMIT

WORKDIR /src/qBittorrent

RUN <<EOF
set -e
git clone \
	--depth 1 \
	--recurse-submodules \
	--shallow-submodules \
	-j8 \
	--single-branch \
    -b "release-${IMAGE_QBITTORRENT_VERSION}" \
	https://github.com/qbittorrent/qBittorrent \
