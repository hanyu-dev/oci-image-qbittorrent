ARG IMAGE_ALPINE_VERSION=3.24.2
ARG IMAGE_ALPINE_DIGEST=294b683cb724975bec92580e1e685676bd4b50bda910ddb8c51d4cabeaec77e6

FROM docker.io/library/alpine:${IMAGE_ALPINE_VERSION}@sha256:${IMAGE_ALPINE_DIGEST}

ARG IMAGE_VCS_DATE_EPOCH
ENV SOURCE_DATE_EPOCH=${IMAGE_VCS_DATE_EPOCH}

RUN <<'EOF'
set -e
apk add --no-cache \
	build-base=0.5-r4 \
	ca-certificates=20261020-r0 \
	cmake=4.2.3-r0 \
	coreutils=9.11-r0 \
	curl=8.22.0-r0 \
	fortify-headers=3.0.1-r2 \
	git=2.54.0-r0 \
	linux-headers=7.0.0-r1 \
	perl=5.42.2-r1 \
	pkgconf=2.5.1-r0 \
	python3=3.14.8-r0 \
	python3-dev=3.14.8-r0 \
	samurai=1.2-r8 \
	tar=1.35-r5 \
	xz=5.8.4-r0
rm -rf /var/lib/apk/tmp/* /var/cache/apk/* /var/log/apk.log
EOF

# === source code: madler/zlib ===

ARG IMAGE_DEP_ZLIB_VERSION
ARG IMAGE_DEP_ZLIB_COMMIT

WORKDIR /src/zlib

RUN <<EOF
set -e
git clone \
	--depth 1 \
	--recurse-submodules \
	--shallow-submodules \
	-j8 \
	--single-branch \
    -b "v${IMAGE_DEP_ZLIB_VERSION}" \
    https://github.com/madler/zlib \
    .
git checkout "${IMAGE_DEP_ZLIB_COMMIT}"
rm -rf .git
EOF

# === source code: openssl/openssl ===

ARG IMAGE_DEP_OPENSSL_VERSION
ARG IMAGE_DEP_OPENSSL_COMMIT

WORKDIR /src/openssl

RUN <<EOF
set -e
git clone \
	--depth 1 \
	--recurse-submodules \
	--shallow-submodules \
	-j8 \
	--single-branch \
    -b "openssl-${IMAGE_DEP_OPENSSL_VERSION}" \
    https://github.com/openssl/openssl \
    .
git checkout "${IMAGE_DEP_OPENSSL_COMMIT}"
rm -rf .git
EOF

# === source code: boostorg/boost (headers only) ===

ARG IMAGE_DEP_BOOST_VERSION
ARG IMAGE_DEP_BOOST_COMMIT

WORKDIR /src/boost

RUN <<EOF
set -e
git clone \
	--depth 1 \
	--recurse-submodules \
	--shallow-submodules \
	-j16 \
	--single-branch \
    -b "boost-${IMAGE_DEP_BOOST_VERSION}" \
    https://github.com/boostorg/boost \
    .
git checkout "${IMAGE_DEP_BOOST_COMMIT}"
rm -rf .git
EOF

